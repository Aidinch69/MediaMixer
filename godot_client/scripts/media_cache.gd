extends Node
## Autoload singleton: Godot can't decode H.264/MP4 (patent-encumbered,
## not in core), so every clip needs a one-time local transcode to Theora
## (.ogv, Godot's built-in format) before a VideoStreamPlayer can show it.
## Runs entirely on this machine via the same ffmpeg already installed for
## the existing proxy pipeline - no Flask/backend changes at all. Prefers
## the existing low-res .proxy.mp4 (already generated by mediamixer.proxy
## for dense grids) over the full-res original, since it's already small
## and fast to re-encode; only scales down full-res originals that don't
## have a proxy yet. Several transcodes run concurrently (MAX_WORKERS) -
## unlike mediamixer/proxy.py's deliberately-serial executor (which is
## competing with live mpv decode on the same process), playback here is
## cheap Theora software decode in a separate process from this encode
## work, so there's real headroom to parallelize popluating a large grid
## (6x6, 8x8) without starving anything.

const CACHE_SUBDIR := "theora_cache"
const MAX_WORKERS := 4

var _media_root: String
var _proxy_root: String
var _overlay_fx_root: String
var _cache_root: String
var _ffmpeg_path: String = ""
var _queue: Array = []
var _active_workers := 0
var _ready_paths: Dictionary = {}


func _ready() -> void:
	var root := ProjectSettings.globalize_path("res://../").simplify_path()
	_media_root = root.path_join("media_assets")
	_proxy_root = root.path_join("media_proxies")
	_overlay_fx_root = root.path_join("overlay_fx")
	_cache_root = OS.get_user_data_dir().path_join(CACHE_SUBDIR)
	DirAccess.make_dir_recursive_absolute(_cache_root)
	_ffmpeg_path = _find_ffmpeg()
	if _ffmpeg_path == "":
		push_warning("MediaCache: ffmpeg not found - video tiles will stay empty")


func _find_ffmpeg() -> String:
	var localapp := OS.get_environment("LOCALAPPDATA")
	if localapp == "":
		return ""
	var packages_dir := localapp + "\\Microsoft\\WinGet\\Packages"
	if not DirAccess.dir_exists_absolute(packages_dir):
		return ""
	var dir := DirAccess.open(packages_dir)
	dir.list_dir_begin()
	var entry := dir.get_next()
	while entry != "":
		if entry.begins_with("Gyan.FFmpeg") and dir.current_is_dir():
			var pkg_dir := packages_dir + "\\" + entry
			var inner := DirAccess.open(pkg_dir)
			inner.list_dir_begin()
			var sub := inner.get_next()
			while sub != "":
				if sub.begins_with("ffmpeg-") and inner.current_is_dir():
					var exe := pkg_dir + "\\" + sub + "\\bin\\ffmpeg.exe"
					if FileAccess.file_exists(exe):
						return exe
				sub = inner.get_next()
		entry = dir.get_next()
	return ""


## base: "/media/" (grid clips + "library"-source overlay FX - has a low-res
## .proxy.mp4 tier) or "/overlay_fx/" (dedicated overlay FX assets - no
## proxy tier, served straight from overlay_fx/). rel_path: forward-slash
## path as given by the snapshot/overlay_fx list. callback receives a local
## filesystem path to a playable .ogv, or "" on failure.
func get_video(base: String, rel_path: String, callback: Callable) -> void:
	var key := base + rel_path
	if _ready_paths.has(key):
		if callback.is_valid():
			callback.call(_ready_paths[key])
		return
	var cache_name := key.replace("/", "__").replace("\\", "__").get_basename() + ".ogv"
	var cache_path := _cache_root.path_join(cache_name)
	if FileAccess.file_exists(cache_path):
		_ready_paths[key] = cache_path
		if callback.is_valid():
			callback.call(cache_path)
		return
	_queue.append({"key": key, "base": base, "rel_path": rel_path, "cache_path": cache_path, "callback": callback})
	_process_queue()


func _resolve_source(base: String, rel_path: String) -> Dictionary:
	if base == "/overlay_fx/":
		var fx_path := _overlay_fx_root.path_join(rel_path)
		if FileAccess.file_exists(fx_path):
			return {"path": fx_path, "full_res": true}
		return {"path": "", "full_res": false}
	var proxy_path := _proxy_root.path_join(rel_path.get_basename() + ".proxy.mp4")
	if FileAccess.file_exists(proxy_path):
		return {"path": proxy_path, "full_res": false}
	var asset_path := _media_root.path_join(rel_path)
	if FileAccess.file_exists(asset_path):
		return {"path": asset_path, "full_res": true}
	return {"path": "", "full_res": false}


func _process_queue() -> void:
	if _active_workers >= MAX_WORKERS or _queue.is_empty():
		return
	if _ffmpeg_path == "":
		var job = _queue.pop_front()
		if job.callback.is_valid():
			job.callback.call("")
		_process_queue()
		return
	var job = _queue.pop_front()
	var src := _resolve_source(job.base, job.rel_path)
	if src.path == "":
		if job.callback.is_valid():
			job.callback.call("")
		_process_queue()
		return
	_active_workers += 1
	var thread := Thread.new()
	thread.start(_transcode_worker.bind(src.path, src.full_res, job, thread))
	_process_queue()


func _transcode_worker(source: String, full_res: bool, job: Dictionary, thread: Thread) -> void:
	var tmp_path: String = job.cache_path + ".tmp"
	var args := ["-y", "-i", source]
	if full_res:
		args += ["-vf", "scale=640:640:force_original_aspect_ratio=decrease:force_divisible_by=2"]
	# ffmpeg infers the container from the output filename's extension;
	# the .tmp suffix (atomic write-then-rename) defeats that, so name
	# the muxer explicitly, same fix as mediamixer/proxy.py's _generate().
	args += ["-c:v", "libtheora", "-q:v", "6", "-an", "-f", "ogg", tmp_path]
	var out := []
	OS.execute(_ffmpeg_path, args, out, true, false)
	var ok := FileAccess.file_exists(tmp_path)
	if not ok:
		push_warning("MediaCache: transcode failed for %s: %s" % [source, out])
	if ok:
		DirAccess.rename_absolute(tmp_path, job.cache_path)
	call_deferred("_on_transcode_done", job, ok, thread)


func _on_transcode_done(job: Dictionary, ok: bool, thread: Thread) -> void:
	thread.wait_to_finish()
	_active_workers -= 1
	if ok:
		_ready_paths[job.key] = job.cache_path
	# The tile/floater that requested this clip may have been freed in the
	# meantime (grid rebuild, floater finished its drift) - the callable's
	# bound object check catches that instead of calling into freed memory.
	if job.callback.is_valid():
		job.callback.call(job.cache_path if ok else "")
	_process_queue()
